# Copy this file to .env and fill in real values before running locally.
# python-dotenv (already in requirements.txt) loads .env automatically if
# you add `from dotenv import load_dotenv; load_dotenv()` to app.py, or
# export these the normal way in your shell / hosting platform's dashboard.

# A random string used to sign Flask's session cookies. Any long random
# string works — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Which port the dev server binds to (most PaaS providers set this for you
# automatically and this can be left alone).
PORT=5000

# 1 for Flask's auto-reload + debugger during local development, 0 in
# anything resembling production.
FLASK_DEBUG=1

# Nothing else is required to run Kimpto. Bring-your-own-key API keys
# (Claude / GPT / Gemini) are entered in the app's Settings panel by
# whoever is using it, at request time — they are never read from
# environment variables or stored server-side.
